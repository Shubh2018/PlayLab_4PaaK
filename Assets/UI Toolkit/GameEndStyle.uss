:root {
}

.button {
    width: 201px;
    height: 78px;
    align-self: center;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
    font-size: 64px;
    margin-top: 40px;
    transition-duration: 0.35s;
    -unity-font-definition: url("project://database/Assets/Fonts/LuckiestGuy.ttf?fileID=12800000&guid=7be395409b827c64c803783fb0a76271&type=3#LuckiestGuy");
    border-left-color: rgba(255, 234, 234, 0);
    border-right-color: rgba(255, 234, 234, 0);
    border-top-color: rgba(255, 234, 234, 0);
    border-bottom-color: rgba(255, 234, 234, 0);
    transform-origin: center;
    background-color: rgba(255, 255, 255, 0);
}

.button:hover {
    scale: 1.1 1.1;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
