    <ui:VisualElement name="Container" enabled="true" style="flex-grow: 1; align-self: stretch; align-content: flex-start; opacity: 1; background-image: none; padding-top: 121px; padding-right: 121px; padding-bottom: 121px; padding-left: 121px; justify-content: center; -unity-background-image-tint-color: rgb(128, 128, 128); background-color: rgba(77, 77, 77, 0.78);">
        <ui:Label text="Paused" style="font-size: 100px; align-items: center; align-self: center; -unity-font-definition: url(&quot;project://database/Assets/Fonts/LuckiestGuy.ttf?fileID=12800000&amp;guid=7be395409b827c64c803783fb0a76271&amp;type=3#LuckiestGuy&quot;); color: rgb(229, 229, 229); margin-top: 200px;" />
        <ui:VisualElement name="ButtonContainer" enabled="true" style="flex-grow: 1; flex-direction: row; align-items: stretch; justify-content: center; margin-top: -150px; margin-right: 0; margin-bottom: 180px; margin-left: 0; right: 0; bottom: 0; left: 0; top: 0; align-self: stretch; align-content: center; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgba(255, 255, 255, 0); color: rgb(229, 229, 229);">
            <ui:Button name="ResumeGame" display-tooltip-when-elided="true" double-click-selects-word="false" text="resume" class="button" style="background-image: url(&quot;project://database/Assets/Art/SetSail.png?fileID=21300000&amp;guid=85583c287a4e3a240a5d3e0c1c007367&amp;type=3#SetSail&quot;); background-position-x: center 0; margin-top: 40px; margin-right: 40px; margin-bottom: 40px; margin-left: 40px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; transition-property: all; transition-duration: 0.35s; transition-timing-function: ease; transition-delay: 0s; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); height: 80px; width: 200px; opacity: 1; font-size: 36px; color: rgb(255, 255, 255); -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/Fonts/LuckiestGuy.ttf?fileID=12800000&amp;guid=7be395409b827c64c803783fb0a76271&amp;type=3#LuckiestGuy&quot;); -unity-background-scale-mode: scale-to-fit;" />
            <ui:Button name="MainMenu" text="main menu" class="button" style="background-image: url(&quot;project://database/Assets/Art/HowToPlay.png?fileID=21300000&amp;guid=a02c96a25feaaad499f301ff77f50105&amp;type=3#HowToPlay&quot;); margin-top: 40px; margin-right: 40px; margin-bottom: 40px; margin-left: 40px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; width: 250px; height: 110px; color: rgb(255, 255, 255); font-size: 36px; background-size: contain; -unity-background-scale-mode: scale-to-fit;" />
