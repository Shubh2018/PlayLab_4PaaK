    <ui:VisualElement name="Container" enabled="true" style="flex-grow: 1; align-self: stretch; align-content: flex-start; opacity: 1; background-image: url(&quot;project://database/Assets/Art/Title%20Screen(1).png?fileID=21300000&amp;guid=82118599586f8b94aa1409bfb288eab3&amp;type=3#Title Screen(1)&quot;); padding-top: 121px; padding-right: 121px; padding-bottom: 121px; padding-left: 121px;">
        <ui:VisualElement name="Title" focusable="true" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Art/Title.png?fileID=21300000&amp;guid=5bfd15b01c3920c4c97777080b0e5f43&amp;type=3#Title&quot;); -unity-background-scale-mode: scale-to-fit; background-color: rgba(255, 255, 255, 0); background-size: contain; scale: 1 1; flex-direction: column; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-position-y: center 0; translate: 0 0; width: auto; align-self: stretch; justify-content: flex-start; align-items: stretch; border-top-width: 16px; border-right-width: 16px; border-bottom-width: 16px; border-left-width: 16px; height: auto; align-content: stretch;" />
        <ui:Label text="Four rival captains race through a cursed, emerald archipelago; claim islands and earn points!" style="-unity-text-align: middle-center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 40px; padding-bottom: 40px; padding-left: 40px; font-size: 36px; text-overflow: clip; white-space: normal; color: rgb(255, 255, 255); width: 936px; align-items: stretch; justify-content: center; align-self: center; -unity-font-definition: url(&quot;project://database/Assets/Fonts/IMFellDWPica-Regular%20SDF.asset?fileID=11400000&amp;guid=df6f13d84e918604991808222f8e3c3a&amp;type=2#IMFellDWPica-Regular SDF&quot;);" />
