:root {
}

.header {
    font-size: 360px;
    -unity-text-align: upper-center;
    -unity-text-outline-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    align-self: center;
    margin-top: 128px;
    -unity-font-definition: url("project://database/Assets/Fonts/LuckiestGuy.ttf?fileID=12800000&guid=7be395409b827c64c803783fb0a76271&type=3#LuckiestGuy");
    background-image: url("project://database/Assets/Art/MainTitle.png?fileID=2800000&guid=ebda6a19f502a2c45bfbf8c98af11f16&type=3#MainTitle");
    justify-content: space-between;
}

.button {
    width: 201px;
    height: 78px;
    align-self: center;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
    font-size: 64px;
    margin-top: 40px;
    transition-duration: 0.35s;
    -unity-font-definition: url("project://database/Assets/Fonts/LuckiestGuy.ttf?fileID=12800000&guid=7be395409b827c64c803783fb0a76271&type=3#LuckiestGuy");
    border-left-color: rgba(255, 234, 234, 0);
    border-right-color: rgba(255, 234, 234, 0);
    border-top-color: rgba(255, 234, 234, 0);
    border-bottom-color: rgba(255, 234, 234, 0);
    transform-origin: center;
    background-color: rgba(255, 255, 255, 0);
}

.button:hover {
    scale: 1.1 1.1;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.text {
    align-self: center;
    font-size: 48px;
    color: rgb(255, 255, 255);
}

.image {
    background-image: none;
    justify-content: space-around;
    align-self: center;
    margin-top: 128px;
    -unity-text-outline-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}
